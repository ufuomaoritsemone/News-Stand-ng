<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NigerianNewsGrid.Client.Models;assembly=NigerianNewsGrid.Client"
             xmlns:appmodels="clr-namespace:NigerianNewGrid.Models"
             xmlns:viewmodels="clr-namespace:NigerianNewGrid.ViewModels"
             xmlns:local="clr-namespace:NigerianNewGrid"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:constants="clr-namespace:NigerianNewGrid.Constants"
             xmlns:selectors="clr-namespace:NigerianNewGrid.TemplateSelectors"
             x:Class="NigerianNewGrid.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="Home"
             Background="{StaticResource SecondaryLightBrush}"
             SafeAreaEdges="Container">

    <ContentPage.Resources>
        <ResourceDictionary>
            <selectors:StoryItemTemplateSelector x:Key="StoryItemSelector">
                <!-- Standard / Direct Sponsored Article Template -->
                <selectors:StoryItemTemplateSelector.StoryTemplate>
                    <DataTemplate x:DataType="models:BriefingItem">
                        <!-- GoRead Card: thumbnail left, content right -->
                        <Border Padding="0"
                                Margin="0,0,0,12"
                                Background="{StaticResource WhiteBrush}"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray100Brush}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArticleTapped"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="130,*" ColumnSpacing="0"
                                  MinimumHeightRequest="140">

                                <!-- Thumbnail (left panel, rounded left corners only) -->
                                <Border Grid.Column="0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16,0,16,0"
                                        HeightRequest="140"
                                        WidthRequest="130"
                                        VerticalOptions="Fill">
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="140"
                                           WidthRequest="130"
                                           VerticalOptions="Fill" />
                                </Border>

                                <!-- Content (right panel) -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Padding="14,10,14,10"
                                                     Spacing="4"
                                                     VerticalOptions="Center">

                                    <!-- Category & Sponsored Badge Row -->
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <!-- Pin Icon -->
                                        <Label Text="📌"
                                               FontSize="10"
                                               IsVisible="{Binding IsPinned}"
                                               VerticalOptions="Center" />

                                        <!-- Special Placement Badge (Slots 1, 2, 3) -->
                                        <Border IsVisible="{Binding IsSpecialPlacement}"
                                                Padding="6,2"
                                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Label Text="⭐ SPECIAL SPONSOR"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#FDE68A}" />
                                        </Border>

                                        <!-- Sponsored Badge Pill -->
                                        <Border IsVisible="{Binding IsSponsored}"
                                                Padding="6,2"
                                                BackgroundColor="{AppThemeBinding Light=#E6F4EA, Dark=#137333}"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Label Text="SPONSORED"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#137333, Dark=#CEEAD6}" />
                                        </Border>

                                        <!-- Category label -->
                                        <Label Text="{Binding Category}"
                                               FontFamily="LegacySansBook"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}"
                                               TextTransform="Uppercase"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Headline -->
                                    <Label Text="{Binding Title}"
                                           FontFamily="LegacySerifBold"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           MaxLines="4"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />

                                    <!-- Source · time ago row -->
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding Source}"
                                               FontFamily="LegacySansBook"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray500}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="•"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding TimeAgoText}"
                                               FontFamily="LegacySansBook"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray500}" />
                                    </HorizontalStackLayout>

                                    <!-- Action row — Bookmark + Share -->
                                    <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                        <Button Text="🔖"
                                                Clicked="OnBookmarkClicked"
                                                CommandParameter="{Binding .}"
                                                Padding="0"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                MinimumHeightRequest="36"
                                                MinimumWidthRequest="36"
                                                FontSize="13"
                                                CornerRadius="10"
                                                BorderWidth="1.5"
                                                BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                                                TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"
                                                SemanticProperties.Hint="Bookmark story" />
                                        <Button Text="↗"
                                                Clicked="OnShareClicked"
                                                CommandParameter="{Binding .}"
                                                Padding="0"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                MinimumHeightRequest="36"
                                                MinimumWidthRequest="36"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                BorderWidth="1.5"
                                                BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                                                TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"
                                                SemanticProperties.Hint="Share story" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </selectors:StoryItemTemplateSelector.StoryTemplate>

                <!-- In-Feed Native AdMob Card with EXACT SAME Dimensions (130x140) -->
                <selectors:StoryItemTemplateSelector.NativeAdTemplate>
                    <DataTemplate x:DataType="models:BriefingItem">
                        <admob:NativeAdView AdUnitId="{x:Static constants:AdConstants.NativeAdUnitId}"
                                            Margin="0,0,0,12">
                            <admob:NativeAdView.AdContent>
                                <ContentView x:DataType="{x:Null}">
                                    <Border Padding="0"
                                            Background="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark={StaticResource Gray800Brush}}"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray100Brush}, Dark={StaticResource Gray700Brush}}">
                                        <Grid ColumnDefinitions="130,*" ColumnSpacing="0" MinimumHeightRequest="140">
                                            <!-- Thumbnail (left panel, rounded left corners only: 130x140) -->
                                            <Border Grid.Column="0"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 16,0,16,0"
                                                    HeightRequest="140"
                                                    WidthRequest="130"
                                                    VerticalOptions="Fill">
                                                <admob:MediaView HeightRequest="140"
                                                                 WidthRequest="130"
                                                                 VerticalOptions="Fill" />
                                            </Border>

                                            <!-- Content (right panel) -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Padding="14,10,14,10"
                                                                 Spacing="4"
                                                                 VerticalOptions="Center">
                                                <!-- Attribution Row -->
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Border Padding="6,2"
                                                            BackgroundColor="{AppThemeBinding Light=#E6F4EA, Dark=#137333}"
                                                            StrokeShape="RoundRectangle 6"
                                                            StrokeThickness="0">
                                                        <Label Text="AD • SPONSORED"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light=#137333, Dark=#CEEAD6}" />
                                                    </Border>
                                                    <Label Text="{Binding Advertiser}"
                                                           FontFamily="LegacySansBook"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Gray500}"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation" />
                                                </HorizontalStackLayout>

                                                <!-- Headline -->
                                                <Label Text="{Binding Headline}"
                                                       FontFamily="LegacySerifBold"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       MaxLines="3"
                                                       LineBreakMode="WordWrap"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />

                                                <!-- Call To Action -->
                                                <Label Text="{Binding CallToAction, FallbackValue='Learn More →'}"
                                                       FontFamily="LegacySansBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource AccentBlue}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </ContentView>
                            </admob:NativeAdView.AdContent>
                        </admob:NativeAdView>
                    </DataTemplate>
                </selectors:StoryItemTemplateSelector.NativeAdTemplate>
            </selectors:StoryItemTemplateSelector>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ══════════════════════════════════════════════
             TOP APP BAR — Logo · Title · Actions (Always visible)
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Background="{StaticResource AlwaysWhiteBrush}"
                Padding="16,10,16,8">
            <VerticalStackLayout Spacing="6">
                <!-- Row 1: Masthead & Actions -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <!-- Masthead / Logo -->
                    <Image Grid.Column="0"
                           Source="newsstand_mast_head.png"
                           HeightRequest="36"
                           Aspect="AspectFit"
                           HorizontalOptions="Start"
                           VerticalOptions="Center"
                           SemanticProperties.Description="News Stand NG" />

                    <!-- Action buttons -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <!-- Search shortcut button -->
                        <Button Text="🔍"
                                Clicked="OnSearchToolbarClicked"
                                Padding="10,6"
                                FontSize="15"
                                CornerRadius="14"
                                BorderWidth="1.5"
                                BorderColor="{StaticResource ButtonBorderLight}"
                                BackgroundColor="{StaticResource ButtonBgLight}"
                                TextColor="{StaticResource ButtonTextLight}"
                                SemanticProperties.Hint="Search news topics" />

                        <!-- Refresh button -->
                        <Button Text="↻"
                                Command="{Binding RefreshCommand}"
                                Padding="10,6"
                                FontSize="16"
                                CornerRadius="14"
                                BorderWidth="1.5"
                                BorderColor="{StaticResource ButtonBorderLight}"
                                BackgroundColor="{StaticResource ButtonBgLight}"
                                TextColor="{StaticResource ButtonTextLight}"
                                SemanticProperties.Hint="Reload briefing" />

                        <!-- Audio briefing button -->
                        <Button Text="{Binding AudioButtonText}"
                                Command="{Binding PlayAudioBriefingCommand}"
                                Padding="10,6"
                                FontSize="16"
                                CornerRadius="14"
                                BorderWidth="1.5"
                                BorderColor="{StaticResource AccentOrange}"
                                BackgroundColor="{StaticResource AccentOrangeLight}"
                                TextColor="{StaticResource AccentOrange}"
                                SemanticProperties.Hint="{Binding AudioButtonHint}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Row 2: Status / Live Timestamp Strip -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Padding="2,0,0,0">
                    <Label Text="●"
                           FontSize="9"
                           TextColor="{StaticResource AccentGreen}"
                           VerticalOptions="Center" />
                    <Label x:Name="StatusLabel"
                           Text="{Binding StatusText}"
                           FontFamily="LegacySansBook"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray600}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- ══════════════════════════════════════════════
             SCROLLABLE FEED (RefreshView + ScrollView)
        ══════════════════════════════════════════════ -->
        <RefreshView Grid.Row="1"
                     x:Name="BriefingRefreshView"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <ScrollView x:Name="FeedScrollView">
                <VerticalStackLayout Padding="20,16,20,0"
                                     Spacing="12"
                                     Background="{StaticResource SecondaryLightBrush}">

                    <!-- Skeleton Loading State -->
                    <VerticalStackLayout x:Name="SkeletonLoadingView"
                                         IsVisible="{Binding IsSkeletonVisible}"
                                         Spacing="14"
                                         Padding="0,4,0,12">
                        <Border Padding="16"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200Brush}, Dark={StaticResource Gray700Brush}}"
                                StrokeShape="RoundRectangle 16"
                                Background="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark={StaticResource Gray800Brush}}">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,90" RowSpacing="8" ColumnSpacing="12">
                                <BoxView Grid.Row="0" Grid.Column="0" HeightRequest="14" WidthRequest="80" HorizontalOptions="Start" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                <BoxView Grid.Row="1" Grid.Column="0" HeightRequest="20" HorizontalOptions="Fill" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                <BoxView Grid.Row="2" Grid.Column="0" HeightRequest="14" WidthRequest="180" HorizontalOptions="Start" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                <BoxView Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" HeightRequest="80" WidthRequest="90" CornerRadius="12" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                            </Grid>
                        </Border>
                        <Border Padding="16"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200Brush}, Dark={StaticResource Gray700Brush}}"
                                StrokeShape="RoundRectangle 16"
                                Background="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark={StaticResource Gray800Brush}}">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,90" RowSpacing="8" ColumnSpacing="12">
                                <BoxView Grid.Row="0" Grid.Column="0" HeightRequest="14" WidthRequest="100" HorizontalOptions="Start" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                <BoxView Grid.Row="1" Grid.Column="0" HeightRequest="20" HorizontalOptions="Fill" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                <BoxView Grid.Row="2" Grid.Column="0" HeightRequest="14" WidthRequest="150" HorizontalOptions="Start" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                <BoxView Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" HeightRequest="80" WidthRequest="90" CornerRadius="12" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Empty state -->
                    <VerticalStackLayout x:Name="EmptyStateView"
                                         IsVisible="{Binding IsEmptyStateVisible}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="10"
                                         Padding="32">
                        <Label Text="📰" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="No stories found"
                               FontFamily="LegacySerifBold"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />
                        <Label Text="Pull down to refresh or check your internet connection."
                               FontFamily="LegacySansBook"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>

                    <!-- Article list — rendered with smooth BindableLayout (avoiding nested Scroll conflicts) -->
                    <VerticalStackLayout x:Name="CategoriesLayout"
                                         BindableLayout.ItemsSource="{Binding DateGroups}"
                                         IsVisible="{Binding IsCategoriesVisible}"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="appmodels:BriefingDateGroup">
                                <VerticalStackLayout Spacing="0" Margin="0,0,0,12">

                                    <!-- Date Header separating news stories -->
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,8,0,10"
                                          VerticalOptions="Center">

                                        <!-- Calendar Badge -->
                                        <Border Grid.Column="0"
                                                Padding="6,3"
                                                Background="{StaticResource SecondaryBrush}"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Label Text="📅" FontSize="11" VerticalOptions="Center" />
                                        </Border>

                                        <!-- Date Title -->
                                        <Label Grid.Column="1"
                                               Text="{Binding DateHeader}"
                                               FontFamily="LegacySerifBold"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                               VerticalOptions="Center" />

                                        <!-- Story Count Badge -->
                                        <Border Grid.Column="2"
                                                Padding="8,3"
                                                Background="{StaticResource SecondaryBrush}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Stories.Count, StringFormat='{0} stories'}"
                                                   FontFamily="LegacySansBook"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource DarkTextSecondary}}" />
                                        </Border>
                                    </Grid>

                                    <!-- Per-date article list via BindableLayout with StoryItemTemplateSelector -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stories}"
                                                         BindableLayout.ItemTemplateSelector="{StaticResource StoryItemSelector}"
                                                         Spacing="0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Pagination Controls / Load More Stories -->
                    <VerticalStackLayout x:Name="PaginationLayout"
                                         IsVisible="{Binding IsPaginationVisible}"
                                         Spacing="8"
                                         Margin="0,12,0,16"
                                         HorizontalOptions="Fill">
                        <Button x:Name="LoadMoreStoriesBtn"
                                Text="{Binding LoadMoreText}"
                                IsVisible="{Binding IsLoadMoreVisible}"
                                Command="{Binding LoadMoreStoriesCommand}"
                                Style="{StaticResource ActionSecondaryButtonStyle}"
                                HeightRequest="46"
                                HorizontalOptions="Fill" />
                        <Label x:Name="StoriesCountSummaryLabel"
                               Text="{Binding StoriesCountText}"
                               FontFamily="LegacySansBook"
                               FontSize="11"
                               TextColor="{StaticResource Gray500}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- ══════════════════════════════════════════════
                         NATIVE AD — Displayed between article feed and Video News section
                    ══════════════════════════════════════════════ -->
                    <admob:NativeAdView AdUnitId="{x:Static constants:AdConstants.VideoNativeAdUnitId}"
                                        Margin="0,8,0,16">
                        <admob:NativeAdView.AdContent>
                            <ContentView x:DataType="{x:Null}">
                                <Border Padding="0"
                                        Background="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark={StaticResource Gray800Brush}}"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray100Brush}, Dark={StaticResource Gray700Brush}}"
                                        MinimumHeightRequest="110">
                                    <Grid ColumnDefinitions="110,*" ColumnSpacing="0"
                                          MinimumHeightRequest="110">

                                        <!-- Ad Media (left panel) -->
                                        <Border Grid.Column="0"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16,0,16,0"
                                                HeightRequest="110"
                                                WidthRequest="110"
                                                VerticalOptions="Fill">
                                            <admob:MediaView HeightRequest="110"
                                                             WidthRequest="110"
                                                             VerticalOptions="Fill" />
                                        </Border>

                                        <!-- Ad Content (right panel) -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Padding="12,10,12,10"
                                                             Spacing="4"
                                                             VerticalOptions="Center">

                                            <!-- Attribution Row -->
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Border Padding="6,2"
                                                        BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}"
                                                        StrokeShape="RoundRectangle 6"
                                                        StrokeThickness="0">
                                                    <Label Text="AD • SPONSORED"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#B45309, Dark=#FDE68A}" />
                                                </Border>
                                                <Label Text="{Binding Advertiser}"
                                                       FontFamily="LegacySansBook"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray500}"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>

                                            <!-- Headline -->
                                            <Label Text="{Binding Headline}"
                                                   FontFamily="LegacySerifBold"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   MaxLines="2"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />

                                            <!-- Body -->
                                            <Label Text="{Binding Body}"
                                                   FontFamily="LegacySansBook"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray500}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />

                                            <!-- CTA -->
                                            <Label Text="{Binding CallToAction, FallbackValue='Learn More →'}"
                                                   FontFamily="LegacySansBold"
                                                   FontSize="11"
                                                   TextColor="{StaticResource AccentBlue}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </ContentView>
                        </admob:NativeAdView.AdContent>
                    </admob:NativeAdView>

                    <!-- ══════════════════════════════════════════════
                         VIDEO STORIES — YouTube News Broadcasts & Reports
                    ══════════════════════════════════════════════ -->
                    <VerticalStackLayout Spacing="12" Margin="0,16,0,0">

                        <!-- Red Gradient Banner -->
                        <Border Padding="16,12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E60000" Offset="0.0" />
                                    <GradientStop Color="#990000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="🎬" FontSize="20" VerticalOptions="Center" Margin="0,0,8,0" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                    <Label Text="Latest Video News"
                                           FontFamily="LegacySerifBold"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Fresh video stories &amp; broadcasts from Nigerian channels"
                                           FontFamily="LegacySansBook"
                                           FontSize="11"
                                           TextColor="#FCE8E8" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Padding="8,4"
                                        BackgroundColor="#33FFFFFF"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Label Text="WATCH"
                                           FontFamily="LegacySansBook"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Horizontal Video Stories Carousel -->
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never"
                                    Margin="-20,0,-20,0"
                                    Padding="20,0,20,0">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding VideoStories}"
                                                   Spacing="12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:VideoStoryItem">
                                        <Border Padding="0"
                                                WidthRequest="260"
                                                HeightRequest="252"
                                                Background="{StaticResource WhiteBrush}"
                                                StrokeShape="RoundRectangle 16"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource Gray100Brush}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnVideoStoryTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid RowDefinitions="150,*">
                                                <!-- Video Thumbnail + Play Overlay -->
                                                <Grid Grid.Row="0">
                                                     <Image Source="{Binding DisplayThumbnailUrl}"
                                                            Aspect="AspectFill"
                                                            HeightRequest="150"
                                                            WidthRequest="260" />
                                                     <Border BackgroundColor="#4D000000"
                                                             StrokeThickness="0"
                                                             InputTransparent="True"
                                                             VerticalOptions="Fill"
                                                             HorizontalOptions="Fill" />
                                                     
                                                     <!-- Play Icon Circle -->
                                                     <Border BackgroundColor="#CC000000"
                                                             StrokeThickness="0"
                                                             StrokeShape="RoundRectangle 20"
                                                             HeightRequest="38"
                                                             WidthRequest="38"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Center"
                                                             InputTransparent="True">
                                                         <Label Text="▶"
                                                                FontSize="16"
                                                                TextColor="White"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center"
                                                                Margin="2,0,0,0"
                                                                InputTransparent="True" />
                                                     </Border>

                                                    <!-- Channel Badge -->
                                                    <Border Padding="6,2"
                                                            BackgroundColor="#CC000000"
                                                            StrokeShape="RoundRectangle 6"
                                                            StrokeThickness="0"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Start"
                                                            Margin="8">
                                                        <Label Text="{Binding ChannelName}"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               TextColor="White" />
                                                    </Border>

                                                    <!-- Duration Badge -->
                                                    <Border Padding="6,2"
                                                            BackgroundColor="#D9FF0000"
                                                            StrokeShape="RoundRectangle 6"
                                                            StrokeThickness="0"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start"
                                                            Margin="8">
                                                        <Label Text="{Binding Duration}"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               TextColor="White" />
                                                    </Border>
                                                </Grid>

                                                <!-- Video Story Title & Meta -->
                                                <VerticalStackLayout Grid.Row="1" Padding="12,10,12,10" Spacing="3" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}"
                                                           FontFamily="LegacySerifBold"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           MaxLines="3"
                                                           LineBreakMode="WordWrap"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="{Binding Category}"
                                                               FontFamily="LegacySansBook"
                                                               FontSize="10"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}" />
                                                        <Label Text="•"
                                                               FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                        <Label Text="Watch story ↗"
                                                               FontFamily="LegacySansBook"
                                                               FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Bottom spacing so last card isn't hidden by tab bar -->
                    <BoxView HeightRequest="20" Color="Transparent" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ══════════════════════════════════════════════
             FLOATING "NEW STORIES" PILL (Appears on background sync)
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasNewStoriesAvailable}"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,12,0,0"
                Padding="16,8"
                Background="{AppThemeBinding Light=#0F172A, Dark=#1E293B}"
                Stroke="{AppThemeBinding Light=#38BDF8, Dark=#38BDF8}"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 24"
                ZIndex="999"
                SemanticProperties.Description="{Binding NewStoriesPillText}"
                SemanticProperties.Hint="Tap to scroll to top and show new stories">
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.35" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ApplyNewStoriesCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" InputTransparent="True">
                <Label Text="↑"
                       TextColor="#38BDF8"
                       FontSize="15"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Label Text="{Binding NewStoriesPillText}"
                       TextColor="#FFFFFF"
                       FontFamily="LegacySansBook"
                       FontSize="13"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
