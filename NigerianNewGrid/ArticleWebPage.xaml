<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NigerianNewGrid"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:constants="clr-namespace:NigerianNewGrid.Constants"
             x:Class="NigerianNewGrid.ArticleWebPage"
             x:DataType="local:ArticleWebPage"
             Title=""
             Background="{StaticResource WhiteBrush}"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="0" RowSpacing="0">

        <!-- ══════════════════════════════════════════════
             TOP NAVIGATION & READER CONTROLS TOOLBAR
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="12,8"
                Background="{StaticResource WhiteBrush}"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0,0,0,1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSecondary}}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                
                <!-- Back button -->
                <Button Grid.Column="0"
                        Text="← Back"
                        Clicked="OnBackClicked"
                        Padding="10,0"
                        HeightRequest="36"
                        MinimumHeightRequest="36"
                        MinimumWidthRequest="62"
                        FontSize="12"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        BorderWidth="1.5"
                        BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}" />

                <!-- Publisher / Source Info (compact single line) -->
                <Label Grid.Column="1"
                       x:Name="HeaderPublisherLabel"
                       Text="Newspaper"
                       FontSize="12"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="4,0,2,0"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />

                <!-- Reader Mode / Web View Toggle Switch -->
                <Button Grid.Column="2"
                        x:Name="ModeToggleBtn"
                        Text="📖 Reader"
                        Clicked="OnToggleReaderModeClicked"
                        Padding="8,0"
                        HeightRequest="36"
                        MinimumHeightRequest="36"
                        MinimumWidthRequest="72"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        BorderWidth="1.5"
                        BorderColor="{AppThemeBinding Light=#0052CC, Dark=#60A5FA}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource AccentBlue}}"
                        TextColor="White"
                        SemanticProperties.Hint="Toggle Reader Mode or Original Web" />

                <!-- Font Size Adjuster -->
                <Button Grid.Column="3"
                        x:Name="FontSizeBtn"
                        Text="A±"
                        Clicked="OnAdjustFontSizeClicked"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        MinimumHeightRequest="36"
                        MinimumWidthRequest="36"
                        FontSize="12"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        BorderWidth="1.5"
                        BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"
                        SemanticProperties.Hint="Change Reader Text Size" />

                <!-- Bookmark -->
                <Button Grid.Column="4"
                        x:Name="BookmarkBtn"
                        Text="🔖"
                        Clicked="OnBookmarkClicked"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        MinimumHeightRequest="36"
                        MinimumWidthRequest="36"
                        FontSize="13"
                        CornerRadius="10"
                        BorderWidth="1.5"
                        BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"
                        SemanticProperties.Hint="Bookmark this article" />

                <!-- Share -->
                <Button Grid.Column="5"
                        x:Name="ShareBtn"
                        Text="↗"
                        Clicked="OnShareClicked"
                        Padding="0"
                        HeightRequest="36"
                        WidthRequest="36"
                        MinimumHeightRequest="36"
                        MinimumWidthRequest="36"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        BorderWidth="1.5"
                        BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"
                        SemanticProperties.Hint="Share this article" />
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════
             SPONSORED ARTICLE DISCLOSURE BAR
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                x:Name="SponsoredDisclosureBanner"
                IsVisible="False"
                Padding="12,6"
                BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#2A2300}"
                StrokeShape="RoundRectangle 0"
                StrokeThickness="0,0,0,1"
                Stroke="{AppThemeBinding Light=#FFE082, Dark=#FFE082}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" Text="✨" FontSize="12" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       x:Name="SponsoredDisclosureLabel"
                       Text="SPONSORED CONTENT • Presented by Partner"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#B78103, Dark=#FFE082}"
                       VerticalOptions="Center" />
                <Border Grid.Column="2"
                        Padding="6,2"
                        BackgroundColor="{AppThemeBinding Light=#B78103, Dark=#FFE082}"
                        StrokeShape="RoundRectangle 4"
                        StrokeThickness="0">
                    <Label Text="PARTNER"
                           FontSize="9"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=White, Dark=Black}" />
                </Border>
            </Grid>
        </Border>

        <!-- Loading Progress Bar -->
        <ProgressBar Grid.Row="2"
                     x:Name="LoadingProgress"
                     IsVisible="True"
                     Progress="0.3"
                     ProgressColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}"
                     HeightRequest="3" />

        <!-- WebView & Floating Related Stories Container -->
        <Grid Grid.Row="3">
            <!-- 1. INSTANT NATIVE READER VIEW (ScrollView) -->
            <ScrollView x:Name="NativeReaderScrollView"
                        IsVisible="True"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Padding="0">
                <VerticalStackLayout Spacing="0" Padding="0">

                    <!-- Hero Image with subtle rounded bottom corners and overlay -->
                    <Grid x:Name="HeroImageContainer"
                          HeightRequest="230"
                          IsVisible="False"
                          HorizontalOptions="Fill">
                        <Image x:Name="HeroImage"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                        <BoxView VerticalOptions="End"
                                 HeightRequest="50"
                                 Color="#50000000" />
                    </Grid>

                    <!-- Main Editorial Container -->
                    <VerticalStackLayout Spacing="14" Padding="18,16,18,48">

                        <!-- Meta Header: Category Badge + Reading Time + Date -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Border x:Name="CategoryBadge"
                                    Grid.Column="0"
                                    Padding="8,3"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentBlueLight}, Dark={StaticResource DarkSecondary}}"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Label x:Name="CategoryLabel"
                                       Text="NEWS"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}" />
                            </Border>

                            <Label x:Name="ReadTimeLabel"
                                   Grid.Column="1"
                                   Text="⏱️ 3 min read"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray500}"
                                   VerticalOptions="Center" />

                            <Label x:Name="PublishedTimeLabel"
                                   Grid.Column="2"
                                   Text="2h ago"
                                   FontSize="11"
                                   TextColor="{StaticResource Gray500}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Main Editorial Headline -->
                        <Label x:Name="ArticleTitleLabel"
                               Text="Headline"
                               FontFamily="LegacySerifITCTTBold"
                               FontSize="22"
                               FontAttributes="Bold"
                               LineHeight="1.25"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />

                        <!-- Publisher Attribution & Brand Card -->
                        <Border Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource DarkSurface}}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200Brush}, Dark={StaticResource Gray700Brush}}"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="📰" FontSize="16" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label x:Name="PublisherNameLabel"
                                           Text="The Punch"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />
                                    <Label x:Name="PublisherDomainLabel"
                                           Text="punchng.com"
                                           FontSize="10"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="Original ↗"
                                        Clicked="OnOpenOriginalWebClicked"
                                        Padding="10,0"
                                        HeightRequest="28"
                                        MinimumHeightRequest="28"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}"
                                        BorderWidth="1"
                                        BorderColor="{AppThemeBinding Light={StaticResource AccentBlueLight}, Dark={StaticResource DarkSecondary}}" />
                            </Grid>
                        </Border>

                        <!-- Fallback notice when full body text is missing and only summary is cached -->
                        <Border x:Name="NoContentFallbackBanner"
                                IsVisible="False"
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#3B82F6}"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="ℹ️ Showing story summary. Tap below to load the live web story."
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}" />
                                <Button Text="🌐 Load Full Article via Web"
                                        Clicked="OnOpenOriginalWebClicked"
                                        HeightRequest="34"
                                        MinimumHeightRequest="34"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="6"
                                        BackgroundColor="{StaticResource AccentBlue}"
                                        TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Lead Summary / Excerpt (styled italic serif) -->
                        <Label x:Name="ArticleSummaryLabel"
                               Text="Summary"
                               FontFamily="LegacySansBook"
                               FontSize="15"
                               FontAttributes="Italic"
                               LineHeight="1.35"
                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource DarkTextSecondary}}" />

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                        <!-- Formatted Body Paragraphs Container (populated dynamically) -->
                        <VerticalStackLayout x:Name="ArticleContentStack"
                                             Spacing="14" />

                        <!-- Footer Actions Card -->
                        <Border Margin="0,16,0,0"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource DarkSurface}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label Text="Share this story"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource DarkTextPrimary}}" />
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Button Text="🔖 Save"
                                            Clicked="OnBookmarkClicked"
                                            HeightRequest="36"
                                            MinimumHeightRequest="36"
                                            Padding="14,0"
                                            FontSize="12"
                                            CornerRadius="8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                                            TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"
                                            BorderWidth="1"
                                            BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}" />
                                    <Button Text="↗ Share"
                                            Clicked="OnShareClicked"
                                            HeightRequest="36"
                                            MinimumHeightRequest="36"
                                            Padding="14,0"
                                            FontSize="12"
                                            CornerRadius="8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                                            TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"
                                            BorderWidth="1"
                                            BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}" />
                                    <Button Text="🌐 View on Web"
                                            Clicked="OnOpenOriginalWebClicked"
                                            HeightRequest="36"
                                            MinimumHeightRequest="36"
                                            Padding="14,0"
                                            FontSize="12"
                                            CornerRadius="8"
                                            BackgroundColor="{StaticResource AccentBlue}"
                                            TextColor="White" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- 2. FALLBACK / LIVE WEB VIEW -->
            <WebView x:Name="ArticleWebView"
                     IsVisible="False"
                     Navigating="OnNavigating"
                     Navigated="OnNavigated"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />

            <!-- ══════════════════════════════════════════════
                 RELATED STORIES BOTTOM DRAWER / FLOATING PILL
            ══════════════════════════════════════════════ -->
            <Grid x:Name="RelatedDrawerContainer"
                  VerticalOptions="End"
                  HorizontalOptions="Fill"
                  InputTransparent="False">

                <!-- 1. Collapsed Floating Pill Bar -->
                <Border x:Name="RelatedCollapsedBar"
                        IsVisible="False"
                        Margin="16,0,16,16"
                        Padding="14,10"
                        BackgroundColor="{StaticResource MidnightBlue}"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,4" Radius="12" Opacity="0.8" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleRelatedClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label x:Name="RelatedCollapsedLabel"
                               Grid.Column="0"
                               Text="✨ Related Coverage · Loading..."
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Border Grid.Column="1"
                                Padding="8,4"
                                BackgroundColor="#33FFFFFF"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                            <Label Text="Explore ▲"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AccentBlueLight}"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Expanded Bottom Sheet Panel -->
                <Border x:Name="RelatedExpandedSheet"
                        IsVisible="False"
                        HeightRequest="420"
                        Background="{StaticResource WhiteBrush}"
                        StrokeShape="RoundRectangle 24,24,0,0"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray300Brush}">
                    <Border.Shadow>
                        <Shadow Brush="#60000000" Offset="0,-4" Radius="16" Opacity="0.9" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,*" Padding="0">
                        <!-- Top Header & Drag Handle -->
                        <VerticalStackLayout Grid.Row="0" Padding="16,10,16,8" Spacing="6">
                            <!-- Drag Indicator -->
                            <BoxView WidthRequest="44"
                                     HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource Gray400}"
                                     HorizontalOptions="Center" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Label Text="✨ Related Coverage"
                                           FontFamily="LegacySerifBold"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                           VerticalOptions="Center" />
                                    <Border x:Name="RelatedTotalBadge"
                                            Padding="8,2"
                                            BackgroundColor="{StaticResource AccentBlueLight}"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Label x:Name="RelatedTotalCountLabel"
                                               Text="0 found"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Button Grid.Column="1"
                                         Text="✕ Close"
                                         Clicked="OnToggleRelatedClicked"
                                         FontSize="12"
                                         Padding="10,4"
                                         CornerRadius="12"
                                         BorderWidth="1.5"
                                         BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                                         TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Filter Chips Row -->
                        <ScrollView Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never"
                                    Padding="16,0,16,8">
                            <HorizontalStackLayout Spacing="8">
                                <Button x:Name="FilterAllBtn"
                                        Text="All"
                                        Clicked="OnRelatedFilterClicked"
                                        CommandParameter="All"
                                        Padding="14,6"
                                        FontSize="12"
                                        CornerRadius="14"
                                        BorderWidth="1.5"
                                        BorderColor="{AppThemeBinding Light=#0052CC, Dark=#60A5FA}"
                                        BackgroundColor="{StaticResource AccentBlue}"
                                        TextColor="White" />
                                <Button x:Name="FilterArticlesBtn"
                                        Text="📰 Archive"
                                        Clicked="OnRelatedFilterClicked"
                                        CommandParameter="Articles"
                                        Padding="14,6"
                                        FontSize="12"
                                        CornerRadius="14"
                                        BorderWidth="1.5"
                                        BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}" />
                                <Button x:Name="FilterVideosBtn"
                                        Text="🎬 Videos"
                                        Clicked="OnRelatedFilterClicked"
                                        CommandParameter="Videos"
                                        Padding="14,6"
                                        FontSize="12"
                                        CornerRadius="14"
                                        BorderWidth="1.5"
                                        BorderColor="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}" />
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- Related Items List -->
                        <CollectionView Grid.Row="2"
                                        x:Name="RelatedItemsList"
                                        SelectionMode="None"
                                        ItemSizingStrategy="MeasureFirstItem"
                                        Margin="16,0,16,8">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                                    <Label Text="🔍" FontSize="32" HorizontalOptions="Center" />
                                    <Label Text="No related stories in this category yet"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:RelatedStoryDisplayItem">
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            BackgroundColor="{StaticResource SecondaryLight}"
                                            StrokeShape="RoundRectangle 14"
                                            Stroke="{StaticResource Gray200Brush}"
                                            StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRelatedItemCardTapped" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <!-- Thumbnail Container -->
                                            <Grid Grid.Column="0" WidthRequest="82" HeightRequest="68">
                                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                                    <Image Source="{Binding ImageUrl}"
                                                           Aspect="AspectFill"
                                                           WidthRequest="82"
                                                           HeightRequest="68" />
                                                </Border>
                                                <!-- Red play badge for videos -->
                                                <Border IsVisible="{Binding IsVideo}"
                                                        Padding="4,2"
                                                        BackgroundColor="#D9FF0000"
                                                        StrokeShape="RoundRectangle 6"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Label Text="▶" FontSize="11" TextColor="White" />
                                                </Border>
                                            </Grid>

                                            <!-- Middle Info -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Border Padding="6,1"
                                                            BackgroundColor="{StaticResource AccentBlueLight}"
                                                            StrokeShape="RoundRectangle 6"
                                                            StrokeThickness="0">
                                                        <Label Text="{Binding Category}"
                                                                FontSize="9"
                                                                FontAttributes="Bold"
                                                                TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}" />
                                                    </Border>
                                                    <Label Text="{Binding Source}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="•" FontSize="10" TextColor="{StaticResource Gray400}" />
                                                    <Label Text="{Binding TimeAgo}"
                                                           FontSize="10"
                                                           TextColor="{StaticResource Gray500}" />
                                                </HorizontalStackLayout>

                                                <Label Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       MaxLines="4"
                                                       LineBreakMode="WordWrap"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />

                                                <Label Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray600}"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <!-- Right Action Indicator -->
                                            <Label Grid.Column="2"
                                                   Text="→"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}"
                                                   VerticalOptions="Center"
                                                   Margin="4,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════
             STICKY BOTTOM COMPACT BANNER AD (320x50)
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                x:Name="BottomBannerAdContainer"
                Padding="0"
                HeightRequest="50"
                MaximumHeightRequest="50"
                StrokeThickness="0,1,0,0"
                Stroke="{AppThemeBinding Light={StaticResource Gray200Brush}, Dark={StaticResource Gray700Brush}}"
                Background="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark={StaticResource Gray800Brush}}"
                HorizontalOptions="Fill"
                VerticalOptions="End">
            <Grid HeightRequest="50" HorizontalOptions="Fill">
                <admob:BannerAd x:Name="ArticleBannerAd"
                                AdUnitId="{x:Static constants:AdConstants.BannerAdUnitId}"
                                AdSize="Banner"
                                HeightRequest="50"
                                WidthRequest="320"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                <!-- Dismiss button allowing reader to reclaim 100% of the screen space -->
                <Button x:Name="DismissBannerBtn"
                        Text="✕"
                        Clicked="OnDismissBannerClicked"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Margin="0,0,8,0"
                        WidthRequest="22"
                        HeightRequest="22"
                        MinimumWidthRequest="22"
                        MinimumHeightRequest="22"
                        Padding="0"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="11"
                        BackgroundColor="{AppThemeBinding Light=#14000000, Dark=#2EFFFFFF}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                        BorderWidth="0"
                        ToolTipProperties.Text="Dismiss ad"
                        SemanticProperties.Description="Dismiss banner ad" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
