using System.Text.Json;
using NigerianNewsGrid.Client;
using Microsoft.Extensions.DependencyInjection;
using NigerianNewsGrid.Client.Models;

namespace NigerianNewGrid;

public partial class MainPage : ContentPage
{
    private readonly NewsApiClient _apiClient;
    private readonly List<BriefingItem> _bookmarks = new();

        public MainPage()
        {
            InitializeComponent();
            // Resolve API client from DI if available, otherwise create a short-lived client as fallback.
            try
            {
                _apiClient = Microsoft.Maui.Controls.Application.Current?.Handler?.MauiContext?.Services?.GetService<NewsApiClient>()
                    ?? new NewsApiClient(new System.Net.Http.HttpClient());
            }
            catch
            {
                _apiClient = new NewsApiClient(new System.Net.Http.HttpClient());
            }
        Loaded += async (_, _) =>
        {
            try
            {
                await EnsureOnboardingAsync();
                await LoadBriefingAsync();
            }
            catch (Exception ex)
            {
                // Prevent exception from bubbling across the Java<->CLR boundary
                // and give a visible error message while debugging.
                System.Diagnostics.Debug.WriteLine($"MainPage load error: {ex}");
                StatusLabel.Text = "Error loading briefing: " + ex.Message;
            }
        };
    }

    private async Task LoadBriefingAsync()
    {
        var endpoint = await ResolveApiBaseUrlAsync();
        _apiClient.BaseUrl = endpoint;

        var language = Preferences.Get("preferred_language", "English");
        StatusLabel.Text = $"Loading latest briefing for {language} from {endpoint}...";

        var categories = await _apiClient.GetDailyBriefingAsync(language);
        if (categories.Count == 0)
        {
            var cachedJson = Preferences.Get("last_briefing", string.Empty);
            if (!string.IsNullOrWhiteSpace(cachedJson))
            {
                try
                {
                    categories = JsonSerializer.Deserialize<List<BriefingCategory>>(cachedJson) ?? new List<BriefingCategory>();
                    StatusLabel.Text = "Loaded cached briefing";
                }
                catch
                {
                    StatusLabel.Text = "No briefing available. Start the API server to fetch fresh content.";
                }
            }
            else
            {
                StatusLabel.Text = "No briefing available. Start the API server to fetch fresh content.";
            }
        }
        else
        {
            Preferences.Set("last_briefing", JsonSerializer.Serialize(categories));
            Preferences.Set("api_base_url", _apiClient.BaseUrl);
            StatusLabel.Text = $"Loaded {categories.Count} categories for {Preferences.Get("preferred_language", "English")} from {_apiClient.BaseUrl}";
        }

        CategoriesView.ItemsSource = categories;
        RestoreBookmarks();
    }

    private async Task<string> ResolveApiBaseUrlAsync()
    {
        var savedBaseUrl = Preferences.Get("api_base_url", string.Empty);

        using var probeClient = new System.Net.Http.HttpClient();
        probeClient.Timeout = TimeSpan.FromSeconds(2);

        // If we have a cached base url, verify it still responds before returning it.
        if (!string.IsNullOrWhiteSpace(savedBaseUrl))
        {
            try
            {
                var resp = await probeClient.GetAsync($"{savedBaseUrl.TrimEnd('/')}/health");
                if (resp.IsSuccessStatusCode)
                {
                    return savedBaseUrl;
                }
                // Cached endpoint failed - clear it and re-probe candidates
                Preferences.Remove("api_base_url");
            }
            catch
            {
                Preferences.Remove("api_base_url");
            }
        }

        var candidates = new[]
        {
            "http://10.0.2.2:5000",
            "http://localhost:5000",
            "http://127.0.0.1:5000",
            "http://host.docker.internal:5000",
            "http://10.0.2.2:8080",
            "http://localhost:8080",
            "http://host.docker.internal:8080"
        };

        foreach (var candidate in candidates)
        {
            try
            {
                var response = await probeClient.GetAsync($"{candidate.TrimEnd('/')}/health");
                if (response.IsSuccessStatusCode)
                {
                    Preferences.Set("api_base_url", candidate);
                    return candidate;
                }
            }
            catch
            {
                // ignore and try next candidate
            }
        }

        var fallback = DeviceInfo.Platform == DevicePlatform.Android ? "http://10.0.2.2:5000" : "http://localhost:5000";
        Preferences.Set("api_base_url", fallback);
        return fallback;
    }

    private async void OnRefreshClicked(object? sender, EventArgs e) => await LoadBriefingAsync();

    private async void OnOpenArticleClicked(object? sender, EventArgs e)
    {
        if (sender is Button button && button.CommandParameter is string url && !string.IsNullOrWhiteSpace(url))
        {
            await Launcher.OpenAsync(new Uri(url));
        }
    }

    private async void OnPlayAudioClicked(object? sender, EventArgs e)
    {
        if (sender is Button button && button.CommandParameter is string audioUrl && !string.IsNullOrWhiteSpace(audioUrl))
        {
            if (Uri.TryCreate(audioUrl, UriKind.Absolute, out var uri))
            {
                await Launcher.OpenAsync(uri);
            }
            else
            {
                StatusLabel.Text = "Audio link was not valid.";
            }
        }
        else
        {
            StatusLabel.Text = "No audio clip available yet for this story.";
        }
    }

    private void OnBookmarkClicked(object? sender, EventArgs e)
    {
        if (sender is Button button && button.CommandParameter is BriefingItem item)
        {
            if (_bookmarks.Any(existing => existing.Id == item.Id))
            {
                _bookmarks.RemoveAll(existing => existing.Id == item.Id);
                Preferences.Set("bookmarks", JsonSerializer.Serialize(_bookmarks));
                StatusLabel.Text = "Removed bookmark.";
            }
            else
            {
                _bookmarks.Add(item);
                Preferences.Set("bookmarks", JsonSerializer.Serialize(_bookmarks));
                StatusLabel.Text = $"Saved bookmark for {item.Title}";
            }
        }
    }

    private async void OnBookmarksClicked(object? sender, EventArgs e)
    {
        if (_bookmarks.Count == 0)
        {
            StatusLabel.Text = "No bookmarks yet.";
            return;
        }

        StatusLabel.Text = "Bookmarks: " + string.Join(", ", _bookmarks.Select(item => item.Title));
        await DisplayAlertAsync("Bookmarks", string.Join(Environment.NewLine, _bookmarks.Select(item => item.Title)), "OK");
    }

    private async void OnShareClicked(object? sender, EventArgs e)
    {
        if (sender is Button button && button.CommandParameter is BriefingItem item)
        {
            var text = $"Nigerian News Grid: {item.Title}\n{item.Summary ?? string.Empty}\n{item.Url ?? string.Empty}";
            await Share.Default.RequestAsync(new ShareTextRequest { Text = text, Title = "Share story" });
        }
    }

    private async void OnSettingsClicked(object? sender, EventArgs e)
    {
        var options = new[] { "English", "Yoruba", "Igbo", "Hausa" };
        var selection = await DisplayActionSheetAsync("Preferred briefing language", "Cancel", null, options);
        if (!string.IsNullOrWhiteSpace(selection) && selection != "Cancel")
        {
            Preferences.Set("preferred_language", selection);
            Preferences.Set("has_seen_onboarding", true);
            StatusLabel.Text = $"Preferred language set to {selection}";
            await LoadBriefingAsync();
        }
    }

    private async void OnReminderClicked(object? sender, EventArgs e)
    {
        Preferences.Set("daily_reminder_enabled", true);
        await DisplayAlertAsync("Daily reminder", "Daily reminder is enabled. In production, this can be wired to local notifications or push notifications for the morning briefing.", "OK");
    }

    private async Task EnsureOnboardingAsync()
    {
        if (Preferences.Get("has_seen_onboarding", false))
        {
            return;
        }

        var selection = await DisplayActionSheetAsync("Welcome to Nigerian News Grid", "Skip", null, "English", "Yoruba", "Igbo", "Hausa");
        if (!string.IsNullOrWhiteSpace(selection) && selection != "Skip")
        {
            Preferences.Set("preferred_language", selection);
        }
        else
        {
            Preferences.Set("preferred_language", "English");
        }

        Preferences.Set("has_seen_onboarding", true);
        Preferences.Set("daily_reminder_enabled", true);
        StatusLabel.Text = $"Welcome! Your briefing language is set to {Preferences.Get("preferred_language", "English")}.";
    }

    private void RestoreBookmarks()
    {
        var cachedBookmarks = Preferences.Get("bookmarks", string.Empty);
        if (!string.IsNullOrWhiteSpace(cachedBookmarks))
        {
            try
            {
                var items = JsonSerializer.Deserialize<List<BriefingItem>>(cachedBookmarks);
                if (items != null)
                {
                    _bookmarks.Clear();
                    _bookmarks.AddRange(items);
                }
            }
            catch
            {
            }
        }
    }
}
