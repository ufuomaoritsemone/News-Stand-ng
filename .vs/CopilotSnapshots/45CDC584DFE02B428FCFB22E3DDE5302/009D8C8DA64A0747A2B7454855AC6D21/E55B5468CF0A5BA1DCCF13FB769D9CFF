<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NigerianNewGrid.MainPage"
             Title="Nigerian News Grid"
             BackgroundColor="#F7FFF8">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">
        <Border Grid.Row="0"
                Padding="16"
                BackgroundColor="#1F6A3A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20">
            <VerticalStackLayout Spacing="8">
                <Label Text="Nigerian News Grid"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="Daily audio briefing from trusted Nigerian outlets"
                       FontSize="14"
                       TextColor="#FFE7CC" />
                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                    <Button Text="Refresh"
                            Clicked="OnRefreshClicked"
                            BackgroundColor="#F28C28"
                            TextColor="White"
                            CornerRadius="20" />
                    <Button Text="Bookmarks"
                            Clicked="OnBookmarksClicked"
                            BackgroundColor="#FFFFFF"
                            TextColor="#1F6A3A"
                            CornerRadius="20" />
                    <Button Text="Settings"
                            Clicked="OnSettingsClicked"
                            BackgroundColor="#FFFFFF"
                            TextColor="#1F6A3A"
                            CornerRadius="20" />
                    <Button Text="Reminder"
                            Clicked="OnReminderClicked"
                            BackgroundColor="#E5F5E9"
                            TextColor="#1F6A3A"
                            CornerRadius="20" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <Border Padding="12" BackgroundColor="#FFF4E8" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Label x:Name="StatusLabel"
                           Text="Loading latest briefing..."
                           FontAttributes="Bold"
                           TextColor="#8B3C00" />
                </Border>

                <CollectionView x:Name="CategoriesView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    Margin="0,0,0,10"
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    Stroke="#E7F5EA">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Category}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#1F6A3A" />

                                    <CollectionView ItemsSource="{Binding Top}" SelectionMode="None">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10"
                                                        Margin="0,0,0,8"
                                                        BackgroundColor="#FFFDF7"
                                                        StrokeShape="RoundRectangle 12"
                                                        StrokeThickness="0">
                                                    <VerticalStackLayout Spacing="6">
                                                        <Label Text="{Binding Title}"
                                                               FontAttributes="Bold"
                                                               LineBreakMode="WordWrap"
                                                               TextColor="#263238" />
                                                        <Label Text="{Binding Summary}"
                                                               LineBreakMode="WordWrap"
                                                               Opacity="0.8"
                                                               TextColor="#455A64" />
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Border Padding="6,3"
                                                                    BackgroundColor="#EAF7ED"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    StrokeThickness="0">
                                                                <Label Text="{Binding Source}" FontSize="12" TextColor="#2F6B3D" />
                                                            </Border>
                                                            <Border Padding="6,3"
                                                                    BackgroundColor="#FFF0E0"
                                                                    StrokeShape="RoundRectangle 8"
                                                                    StrokeThickness="0">
                                                                <Label Text="{Binding VoiceName}" FontSize="12" TextColor="#A84D00" />
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Button Text="Open"
                                                                    Clicked="OnOpenArticleClicked"
                                                                    CommandParameter="{Binding Url}"
                                                                    BackgroundColor="#1F6A3A"
                                                                    TextColor="White"
                                                                    CornerRadius="16" />
                                                            <Button Text="Audio"
                                                                    Clicked="OnPlayAudioClicked"
                                                                    CommandParameter="{Binding AudioUrl}"
                                                                    BackgroundColor="#F28C28"
                                                                    TextColor="White"
                                                                    CornerRadius="16" />
                                                            <Button Text="Save"
                                                                    Clicked="OnBookmarkClicked"
                                                                    CommandParameter="{Binding .}"
                                                                    BackgroundColor="#EAF7ED"
                                                                    TextColor="#1F6A3A"
                                                                    CornerRadius="16" />
                                                            <Button Text="Share"
                                                                    Clicked="OnShareClicked"
                                                                    CommandParameter="{Binding .}"
                                                                    BackgroundColor="#FFF0E0"
                                                                    TextColor="#A84D00"
                                                                    CornerRadius="16" />
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
