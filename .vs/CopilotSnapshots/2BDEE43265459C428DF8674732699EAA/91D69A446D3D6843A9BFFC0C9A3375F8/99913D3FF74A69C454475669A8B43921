<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Green & Orange scheme — base colors (used by AppThemeBinding below) -->
    <Color x:Key="Primary">#1F6A3A</Color> <!-- deep green for primary headers/buttons -->
    <Color x:Key="PrimaryDark">#14532B</Color>
    <Color x:Key="PrimaryDarkText">#0B3A1E</Color>

    <Color x:Key="Secondary">#EAF7ED</Color> <!-- pale green background -->
    <Color x:Key="SecondaryLight">#F7FFF8</Color>
    <Color x:Key="SecondaryDarkText">#2F6B3D</Color>

    <Color x:Key="AccentOrange">#F28C28</Color>
    <Color x:Key="AccentOrangeLight">#FFF4E8</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#D0D0D0</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#B0B0B0</Color>
    <Color x:Key="Gray500">#7A7A7A</Color>
    <Color x:Key="MidnightBlue">#191970</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#263238</Color>
    <Color x:Key="Gray950">#111111</Color>

    <!-- Dark mode base colors -->
    <Color x:Key="DarkSurface">#121212</Color>
    <Color x:Key="DarkSurfaceElevated">#1E1E1E</Color>
    <Color x:Key="DarkSurfaceCard">#2A2A2A</Color>
    <Color x:Key="DarkPrimary">#4ADE80</Color> <!-- brighter green for dark backgrounds -->
    <Color x:Key="DarkSecondary">#1B3A26</Color>
    <Color x:Key="DarkAccentOrange">#FFA94D</Color>
    <Color x:Key="DarkAccentOrangeLight">#332211</Color>
    <Color x:Key="DarkTextPrimary">#E8E8E8</Color>
    <Color x:Key="DarkTextSecondary">#B0B0B0</Color>

    <!-- Theme-aware brushes using AppThemeBinding for automatic light/dark mode switching -->
    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"
                     Color="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource DarkSecondary}}"/>
    <SolidColorBrush x:Key="SecondaryBrush"
                     Color="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush"
                     Color="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource DarkSurfaceElevated}}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush"
                     Color="{AppThemeBinding Light={StaticResource AccentOrange}, Dark={StaticResource DarkAccentOrange}}"/>
    <SolidColorBrush x:Key="AccentOrangeLightBrush"
                     Color="{AppThemeBinding Light={StaticResource AccentOrangeLight}, Dark={StaticResource DarkAccentOrangeLight}}"/>
    <SolidColorBrush x:Key="WhiteBrush"
                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}"/>
    <SolidColorBrush x:Key="BlackBrush"
                     Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource DarkTextPrimary}}"/>

    <SolidColorBrush x:Key="Gray100Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSurfaceCard}}"/>
    <SolidColorBrush x:Key="Gray300Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource DarkTextSecondary}}"/>
    <SolidColorBrush x:Key="Gray600Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource DarkTextSecondary}}"/>
    <SolidColorBrush x:Key="Gray900Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"/>
</ResourceDictionary>