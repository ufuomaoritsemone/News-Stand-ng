using System.Text.Json;
using NigerianNewsGrid.Client;
using NigerianNewsGrid.Client.Models;

namespace NigerianNewGrid;

public partial class MainPage : ContentPage
{
    private readonly NewsApiClient _apiClient;
    private readonly List<BriefingItem> _bookmarks = new();

    public MainPage()
    {
        InitializeComponent();
        _apiClient = new NewsApiClient();
        _apiClient.BaseUrl = DeviceInfo.Platform == DevicePlatform.Android ? "http://10.0.2.2:5000" : "http://localhost:5000";
        Loaded += async (_, _) => await LoadBriefingAsync();
    }

    private async Task LoadBriefingAsync()
    {
        StatusLabel.Text = "Loading latest briefing...";

        var categories = await _apiClient.GetDailyBriefingAsync();
        if (categories.Count == 0)
        {
            var cachedJson = Preferences.Get("last_briefing", string.Empty);
            if (!string.IsNullOrWhiteSpace(cachedJson))
            {
                try
                {
                    categories = JsonSerializer.Deserialize<List<BriefingCategory>>(cachedJson) ?? new List<BriefingCategory>();
                    StatusLabel.Text = "Loaded cached briefing";
                }
                catch
                {
                    StatusLabel.Text = "No briefing available. Start the API server to fetch fresh content.";
                }
            }
            else
            {
                StatusLabel.Text = "No briefing available. Start the API server to fetch fresh content.";
            }
        }
        else
        {
            Preferences.Set("last_briefing", JsonSerializer.Serialize(categories));
            StatusLabel.Text = $"Loaded {categories.Count} categories";
        }

        CategoriesView.ItemsSource = categories;
    }

    private async void OnRefreshClicked(object? sender, EventArgs e) => await LoadBriefingAsync();

    private async void OnOpenArticleClicked(object? sender, EventArgs e)
    {
        if (sender is Button button && button.CommandParameter is string url && !string.IsNullOrWhiteSpace(url))
        {
            await Launcher.OpenAsync(new Uri(url));
        }
    }

    private async void OnPlayAudioClicked(object? sender, EventArgs e)
    {
        if (sender is Button button && button.CommandParameter is string audioUrl && !string.IsNullOrWhiteSpace(audioUrl))
        {
            if (Uri.TryCreate(audioUrl, UriKind.Absolute, out var uri))
            {
                await Launcher.OpenAsync(uri);
            }
            else
            {
                StatusLabel.Text = "Audio link was not valid.";
            }
        }
        else
        {
            StatusLabel.Text = "No audio clip available yet for this story.";
        }
    }

    private void OnBookmarkClicked(object? sender, EventArgs e)
    {
        if (sender is Button button && button.CommandParameter is BriefingItem item)
        {
            if (_bookmarks.Any(existing => existing.Id == item.Id))
            {
                _bookmarks.RemoveAll(existing => existing.Id == item.Id);
                StatusLabel.Text = "Removed bookmark.";
            }
            else
            {
                _bookmarks.Add(item);
                StatusLabel.Text = $"Saved bookmark for {item.Title}";
            }
        }
    }

    private void OnBookmarksClicked(object? sender, EventArgs e)
    {
        if (_bookmarks.Count == 0)
        {
            StatusLabel.Text = "No bookmarks yet.";
            return;
        }

        StatusLabel.Text = "Bookmarks: " + string.Join(", ", _bookmarks.Select(item => item.Title));
    }
}
