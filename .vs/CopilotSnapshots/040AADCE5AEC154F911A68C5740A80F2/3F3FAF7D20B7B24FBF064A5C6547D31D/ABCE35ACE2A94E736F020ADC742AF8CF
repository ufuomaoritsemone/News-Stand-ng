using System.Net.Http.Json;
using NigerianNewsGrid.Client.Models;

namespace NigerianNewsGrid.Client;

public class NewsApiClient
{
    private readonly HttpClient _httpClient;

    public NewsApiClient(HttpClient? httpClient = null)
    {
        _httpClient = httpClient ?? new HttpClient();
    }

    public string BaseUrl { get; set; } = "http://localhost:5000";

    public async Task<List<BriefingCategory>> GetDailyBriefingAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var uri = new Uri(new Uri(BaseUrl), "api/v1/briefings");
            var response = await _httpClient.GetAsync(uri, cancellationToken);
            response.EnsureSuccessStatusCode();

            var categories = await response.Content.ReadFromJsonAsync<List<BriefingCategory>>(cancellationToken: cancellationToken);
            return categories ?? new List<BriefingCategory>();
        }
        catch
        {
            return new List<BriefingCategory>();
        }
    }
}
