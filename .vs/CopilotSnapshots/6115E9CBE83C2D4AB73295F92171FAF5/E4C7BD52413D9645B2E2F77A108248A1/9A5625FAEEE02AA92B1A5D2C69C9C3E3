<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NigerianNewsGrid.Client.Models;assembly=NigerianNewsGrid.Client"
             x:Class="NigerianNewGrid.BookmarksPage"
             Title="Bookmarks"
             BackgroundColor="{StaticResource SecondaryLight}"
             SafeAreaEdges="Top,Bottom">

    <Grid RowDefinitions="Auto,*" Padding="0" RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="20,16,20,12"
              BackgroundColor="{StaticResource WhiteBrush}"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Bookmarks"
                       FontFamily="LegacySerifBold"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900Brush}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="BookmarkCountLabel"
                       Text="0 saved stories"
                       FontFamily="LegacySansBook"
                       FontSize="13"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Clear All"
                    x:Name="ClearAllBtn"
                    Clicked="OnClearAllClicked"
                    IsVisible="False"
                    Padding="14,8"
                    FontSize="12"
                    CornerRadius="16"
                    BackgroundColor="{StaticResource AccentOrangeLightBrush}"
                    TextColor="{StaticResource AccentOrangeBrush}" />
        </Grid>

        <!-- Bookmark List -->
        <CollectionView Grid.Row="1"
                        x:Name="BookmarksView"
                        SelectionMode="None"
                        Margin="16,12,16,0">

            <!-- Empty State -->
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="16"
                                         Padding="32">
                        <Label Text="🔖" FontSize="56" HorizontalOptions="Center" />
                        <Label Text="No bookmarks yet"
                               FontFamily="LegacySerifBold"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gray900Brush}" />
                        <Label Text="Tap the Bookmark button on any story to save it here for later reading."
                               FontFamily="LegacySansBook"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>

            <!-- Bookmark Item Template — GoRead card style with thumbnail -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BriefingItem">
                    <Border Padding="0"
                            Margin="0,0,0,12"
                            BackgroundColor="{StaticResource WhiteBrush}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="{StaticResource Gray100Brush}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBookmarkTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="0" HeightRequest="100">

                            <!-- Thumbnail Image -->
                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16,0,16,0">
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="100"
                                       WidthRequest="110" />
                            </Border>

                            <!-- Content -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Padding="12,10,12,10"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <!-- Category chip -->
                                <Label Text="{Binding Category}"
                                       FontFamily="LegacySansBook"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentBlueBrush}"
                                       TextTransform="Uppercase" />
                                <!-- Title -->
                                <Label Text="{Binding Title}"
                                       FontFamily="LegacySerifBold"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{StaticResource Gray900Brush}" />
                                <!-- Source -->
                                <Label Text="{Binding Source}"
                                       FontFamily="LegacySansBook"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
