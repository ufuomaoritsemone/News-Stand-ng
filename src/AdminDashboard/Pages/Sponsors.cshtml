@page
@model AdminDashboard.Pages.SponsorsModel
@{
    ViewData["Title"] = "Direct Sponsored Campaigns | Nigerian News";
}

<div class="container-fluid px-4 py-3">

    <!-- Top Dashboard Header -->
    <div class="dashboard-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-3">
                <h1 class="h2 mb-0 text-white brand-font">🤝 Sponsored Campaigns &amp; PR</h1>
                <span class="badge bg-success rounded-pill px-3 py-1 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                    <i class="bi bi-currency-exchange me-1"></i> DIRECT MONETIZATION
                </span>
            </div>
            <p class="text-muted mb-0 mt-1">Manage, schedule, and track direct corporate press releases and sponsor campaigns</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/Index" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
            <a href="/Videos" class="btn btn-outline-danger btn-sm"><i class="bi bi-youtube me-1"></i> Videos</a>
            <a href="/Socials" class="btn btn-outline-info btn-sm"><i class="bi bi-twitter-x me-1"></i> Socials</a>
            <a href="/Analytics" class="btn btn-outline-success btn-sm"><i class="bi bi-bar-chart-fill me-1"></i> Analytics</a>
            <button type="button" class="theme-toggle-btn" onclick="toggleAdminTheme()" title="Toggle Light / Dark Theme">
                <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                <i class="bi bi-sun-fill theme-icon-light"></i>
                <span class="theme-toggle-label">Dark</span>
            </button>
            <button type="button" class="btn btn-gradient btn-sm" data-bs-toggle="modal" data-bs-target="#createCampaignModal">
                <i class="bi bi-plus-circle-fill me-1"></i> New Sponsored Article
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-card border-success text-white mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show glass-card border-danger text-white mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Active Campaigns</div>
                <div class="h2 mb-0 text-white font-weight-bold mt-1">@Model.ActiveCampaigns</div>
                <div class="small text-success mt-1"><i class="bi bi-broadcast"></i> Live in mobile feed</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Total Delivered Views</div>
                <div class="h2 mb-0 text-info font-weight-bold mt-1">@Model.TotalImpressions.ToString("N0")</div>
                <div class="small text-muted mt-1"><i class="bi bi-eye"></i> Feed impressions</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Total Click-Throughs</div>
                <div class="h2 mb-0 text-warning font-weight-bold mt-1">@Model.TotalClicks.ToString("N0")</div>
                <div class="small text-muted mt-1"><i class="bi bi-cursor-fill"></i> Sponsor URL clicks</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Average CTR</div>
                <div class="h2 mb-0 text-success font-weight-bold mt-1">@Model.OverallCtr.ToString("F2")%</div>
                <div class="small text-muted mt-1"><i class="bi bi-graph-up-arrow"></i> Click conversion rate</div>
            </div>
        </div>
    </div>

    <!-- Campaigns List Table Section -->
    <div class="glass-card p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h5 class="text-white mb-0 font-weight-bold"><i class="bi bi-megaphone-fill me-2 text-warning"></i>All Sponsored Campaigns</h5>
                <p class="text-muted small mb-0">Scheduled PR articles and direct advertiser placements</p>
            </div>
            <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#createCampaignModal">
                <i class="bi bi-plus-lg me-1"></i> Create Campaign
            </button>
        </div>

        @if (!Model.Campaigns.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <h5>No Sponsored Campaigns Yet</h5>
                <p class="small">Click the <strong>New Sponsored Article</strong> button above to publish your first direct brand campaign.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="text-muted small text-uppercase border-secondary">
                            <th>Sponsor / Article</th>
                            <th>Slot / Placement</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Impressions</th>
                            <th>Clicks</th>
                            <th>CTR</th>
                            <th>Expires</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Campaigns)
                        {
                            <tr class="border-secondary">
                                <td style="max-width: 320px;">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                        {
                                            <img src="@c.ImageUrl" alt="Thumbnail" class="rounded" style="width: 54px; height: 42px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-secondary d-flex align-items-center justify-content-center" style="width: 54px; height: 42px;">
                                                <i class="bi bi-newspaper text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="text-warning small font-weight-bold text-uppercase">
                                                <i class="bi bi-patch-check-fill me-1"></i>@(c.SponsorName ?? "Direct Sponsor")
                                            </div>
                                            <div class="text-white font-weight-bold text-truncate" style="max-width: 250px;" title="@c.Title">
                                                @c.Title
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(c.SponsorUrl))
                                            {
                                                <a href="@c.SponsorUrl" target="_blank" class="small text-info text-decoration-none" style="font-size: 0.75rem;">
                                                    <i class="bi bi-link-45deg"></i>@(new Uri(c.SponsorUrl).Host) ↗
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (c.IsSpecialPlacement)
                                    {
                                        <span class="badge bg-warning text-dark font-weight-bold">
                                            <i class="bi bi-star-fill me-1"></i>@c.PlacementDisplay
                                        </span>
                                    }
                                    else if (c.TargetPosition.HasValue)
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-geo-alt-fill me-1"></i>@c.PlacementDisplay
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Auto In-Feed</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@c.Category</span>
                                </td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                        @if (c.IsPinned)
                                        {
                                            <span class="badge bg-warning text-dark ms-1"><i class="bi bi-pin-angle-fill me-1"></i>Pinned</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-hourglass-bottom me-1"></i>Expired</span>
                                    }
                                </td>
                                <td>
                                    <span class="font-weight-bold text-info">@c.ImpressionCount.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="font-weight-bold text-warning">@c.ClickCount.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-white">@c.ClickThroughRate.ToString("F2")%</span>
                                </td>
                                <td>
                                    <div class="small text-muted">
                                        @if (c.CampaignExpiresAt.HasValue)
                                        {
                                            <span>@c.CampaignExpiresAt.Value.ToString("MMM d, yyyy")</span>
                                            @if (c.CampaignExpiresAt.Value > DateTime.UtcNow)
                                            {
                                                <div class="text-success small">(@((int)(c.CampaignExpiresAt.Value - DateTime.UtcNow).TotalDays)d remaining)</div>
                                            }
                                            else
                                            {
                                                <div class="text-danger small">(Expired)</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-success">Never (Indefinite)</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- Pin / Unpin Toggle -->
                                        <form method="post" asp-page-handler="TogglePin" class="d-inline">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <input type="hidden" name="currentPinned" value="@(c.IsPinned.ToString().ToLower())" />
                                            <button type="submit" class="btn btn-sm @(c.IsPinned ? "btn-warning" : "btn-outline-secondary")" title="@(c.IsPinned ? "Unpin from feed top" : "Pin to feed top")">
                                                <i class="bi bi-pin-angle@(c.IsPinned ? "-fill" : "")"></i>
                                            </button>
                                        </form>

                                        <!-- Extend Campaign (+14 Days) -->
                                        <form method="post" asp-page-handler="ExtendCampaign" class="d-inline">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <input type="hidden" name="extraDays" value="14" />
                                            <button type="submit" class="btn btn-outline-info btn-sm" title="Extend by +14 days">
                                                <i class="bi bi-calendar-plus"></i> +14d
                                            </button>
                                        </form>

                                        <!-- Delete Campaign -->
                                        <form method="post" asp-page-handler="DeleteCampaign" onsubmit="return confirm('Are you sure you want to delete this sponsored campaign?');" class="d-inline">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Campaign">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<!-- ══════════════════════════════════════════════
     CREATE SPONSORED ARTICLE MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="createCampaignModal" tabindex="-1" aria-labelledby="createCampaignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card border-secondary text-white" style="background: rgba(22, 27, 34, 0.96); backdrop-filter: blur(16px);">
            <form method="post" asp-page-handler="CreateCampaign">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title font-weight-bold" id="createCampaignModalLabel">
                        <i class="bi bi-megaphone-fill me-2 text-warning"></i>Publish Direct Sponsored Story / PR
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        
                        <!-- Headline / Title -->
                        <div class="col-12">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Headline / Campaign Title *</label>
                            <input type="text" name="NewCampaign.Title" required class="form-control form-control-glass" placeholder="e.g. Flutterwave Unveils ₦10B SME Growth Fund for Nigerian Merchants" />
                        </div>

                        <!-- Sponsor Name & Website -->
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Sponsor Brand Name *</label>
                            <input type="text" name="NewCampaign.SponsorName" required class="form-control form-control-glass" placeholder="e.g. Flutterwave, Moniepoint, MTN, Paystack" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Sponsor Landing Page URL</label>
                            <input type="url" name="NewCampaign.SponsorUrl" class="form-control form-control-glass" placeholder="https://brand.com/campaign" />
                        </div>

                        <!-- Category & Image URL -->
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">News Category</label>
                            <select name="NewCampaign.Category" class="form-select form-control-glass">
                                <option value="Business" selected>Business &amp; Finance</option>
                                <option value="Technology">Technology &amp; Startups</option>
                                <option value="Politics">Politics &amp; Economy</option>
                                <option value="General">General News</option>
                                <option value="Sports">Sports</option>
                                <option value="Entertainment">Entertainment</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Creative Image URL</label>
                            <input type="url" name="NewCampaign.ImageUrl" class="form-control form-control-glass" placeholder="https://images.unsplash.com/... or https://..." />
                        </div>

                        <!-- Summary (Shown in Feed) -->
                        <div class="col-12">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Card Summary (Shown in News Feed)</label>
                            <textarea name="NewCampaign.Summary" rows="2" class="form-control form-control-glass" placeholder="Concise 1-2 sentence executive summary of the press release..."></textarea>
                        </div>

                        <!-- Full PR Content / Body -->
                        <div class="col-12">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Full Article / Press Release Content</label>
                            <textarea name="NewCampaign.Content" rows="5" class="form-control form-control-glass" placeholder="Full press release text for in-app reading view..."></textarea>
                        </div>

                        <!-- Target Feed Position & Priority Weight -->
                        <div class="col-md-8">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">
                                Feed Placement Slot
                            </label>
                            <select name="NewCampaign.TargetPosition" class="form-select form-control-glass">
                                <optgroup label="⭐ Special Premium Placements (Top Hero)">
                                    @{
                                        var occupied = Model.GetOccupiedSlots();
                                    }
                                    <option value="1">1st Story — Top Hero Slot @(occupied.ContainsKey(1) ? $"(Occupied: {occupied[1]})" : "(Available)")</option>
                                    <option value="2">2nd Story — Premium Slot @(occupied.ContainsKey(2) ? $"(Occupied: {occupied[2]})" : "(Available)")</option>
                                    <option value="3">3rd Story — Premium Slot @(occupied.ContainsKey(3) ? $"(Occupied: {occupied[3]})" : "(Available)")</option>
                                </optgroup>
                                <optgroup label="📰 In-Feed Placements (5th to 30th Position)">
                                    @for (int slot = 5; slot <= 30; slot++)
                                    {
                                        var isOcc = occupied.ContainsKey(slot);
                                        <option value="@slot" selected="@(slot == 5)">
                                            Position @slot @(isOcc ? $"(Occupied: {occupied[slot]})" : "(Available)")
                                        </option>
                                    }
                                </optgroup>
                            </select>
                            <div class="form-text text-muted" style="font-size: 0.72rem;">
                                Note: Position 4 is reserved as organic editorial buffer. In-feed ads maintain minimum 3-story separation.
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Priority Weight</label>
                            <select name="NewCampaign.PriorityWeight" class="form-select form-control-glass">
                                <option value="1" selected>Normal (1)</option>
                                <option value="5">High (5)</option>
                                <option value="10">Premium (10)</option>
                            </select>
                            <div class="form-text text-muted" style="font-size: 0.72rem;">
                                Tie-breaker when two campaigns target the same slot.
                            </div>
                        </div>

                        <!-- Campaign Duration & Pinning -->
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase font-weight-bold text-muted">Campaign Duration</label>
                            <select name="NewCampaign.DurationDays" class="form-select form-control-glass">
                                <option value="7">7 Days</option>
                                <option value="14" selected>14 Days (Standard)</option>
                                <option value="30">30 Days (Monthly)</option>
                                <option value="60">60 Days (Quarterly)</option>
                                <option value="0">Indefinite (No Expiration)</option>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="isPinnedCheck" name="NewCampaign.IsPinned" value="true" />
                                <label class="form-check-label text-white" for="isPinnedCheck">
                                    <i class="bi bi-pin-angle-fill text-warning me-1"></i>Pin to top of feed
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gradient btn-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Publish Campaign
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
